# Copy to .env.local for `vercel dev`, and set the same keys in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.

# Neon Postgres connection string (pooled). Added automatically when you
# attach the Neon integration in the Vercel Marketplace, usually as
# DATABASE_URL. If yours is named differently, either rename it or update
# the code to read that name.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Vercel Blob read/write token. Added automatically when you attach a Blob
# store to the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Secret used to sign the admin session JWT. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# One-time token that must be sent as the X-Setup-Token header to create the
# first admin account via POST /api/admin/create. Remove it after setup.
SETUP_TOKEN=another-long-random-string
